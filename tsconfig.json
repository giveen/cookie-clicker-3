{
	/* Cookie Clicker 3 — TypeScript 7 config.
	 *
	 * The entire tree — the engine (src/engine/main.ts), the extracted typed
	 * modules (content/, core/, systems/, ui/, utils/), the minigames, the
	 * localization, and the glue (src/main.ts, config, base64, extras) — is
	 * checked under full strict; there is no `@ts-nocheck` anywhere. Vite
	 * (Rolldown/OXC) strips types at build time, so `tsc --noEmit` is the
	 * type gate and never emits.
	 *
	 * incremental: TS 7 caches parse/check results in .tsbuildinfo so
	 * repeat `tsc --noEmit` runs only re-check changed files and their
	 * dependents (typically <200 ms vs ~500 ms cold). The cache file is
	 * ephemeral (gitignored) and not emitted to dist/.
	 */
	"compilerOptions": {
		/* The build target is esnext (Vite); this only feeds type-checking libs. */
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		/* import.meta.env / import.meta.glob typing, plus node for vite.config.ts. */
		"types": ["vite/client", "node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"exactOptionalPropertyTypes": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo"
	},
	"include": ["src", "vite.config.ts"]
}
