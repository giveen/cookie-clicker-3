{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	/* Run `npm run lint` (biome check .). Gate is lint-only: the formatter
	   is off (see formatter.enabled below and docs/biome.md). Validate any
	   change with `npx biome rage` → "Status: Loaded successfully". */
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		/* public/legacy is the frozen 2.048 legacy script set (dungeon,
		   excanvas): served as-is at runtime, not type-checked, written in
		   2014 style (var/function-declaration hoisting, = in expressions,
		   unseeded-radix parseInt). Linting it is pure noise. dist/ and
		   .cc3-master/ are built outputs / the master-baseline checkout. */
		"includes": [
			"**",
			"!!dist",
			"!!.cc3-master",
			"!!node_modules",
			"!!public/legacy",
			/* committed data baselines (upgrades-fingerprint is 3.7 MiB —
			   over the 1 MiB files.maxSize default); generated by test runs,
			   never hand-edited, nothing to lint */
			"!!tests/upgrades-baseline.json",
			"!!tests/balance-baseline.json"
		]
	},
	"formatter": {
		/* Off for the gate: verbatim 2.048 port, ~7,300 lines > 120 chars
		   (lineWidth maxes at 320) → a format gate means a ~170k-line
		   reformat of frozen content. Settings kept so `npx biome format
		   --write <file>` matches repo style on purpose (see docs/biome.md). */
		"enabled": false,
		"indentStyle": "tab",
		"lineWidth": 320
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "none",
			"semicolons": "always"
		}
	},
	"json": {
		/* Keep committed baselines (tests/*-baseline.json) stable diffs. */
		"formatter": {
			"enabled": false
		}
	},
	"overrides": [
		{
			/* Playwright specs and root config files are single-quoted. */
			"includes": ["tests/**", "*.config.js", "playwright.config.js"],
			"javascript": {
				"formatter": {
					"quoteStyle": "single"
				}
			}
		},
		{
			/* The ported engine predates Biome and its idioms trip the
			   unused-variable family: write-only counters (bought++), and
			   same-name var/parameter bindings (var building=Game.Objects[building])
			   where tsc resolves one binding but Biome sees a shadow. These
			   are false positives; tsc noUnusedLocals/Parameters (strict on in
			   tsconfig) is the gate for that axis in src. New code (tests, root
			   config) keeps the Biome rules on. */
			"includes": ["src/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedFunctionParameters": "off"
					}
				}
			}
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			/* The recommended preset is on (default in v2). Off entries below
			   are verbatim-port conflicts: existing code predates the rule and
			   changing it risks behavior — not "the finding is uninteresting".
			   Full rationale: docs/biome.md. */
			"a11y": {
				/* CSS: the 2.048 stylesheet uses system font stacks
				   (Georgia, Comic Sans MS, Arial) without generic fallbacks */
				"useGenericFontNames": "off",
				/* HTML: index.html's #helpButton / #changeLanguage are JS-driven
				   anchors without href (vanilla 2.048 markup; a href="#" would
				   add navigation the handlers don't preventDefault) */
				"useValidAnchor": "off"
			},
			"style": {
				/* legacy string-concat / ** style, thousands of port sites */
				"useTemplate": "off",
				"useExponentiationOperator": "off",
				/* the port uses ! liberally */
				"noNonNullAssertion": "off",
				/* CSS: intentional selector ordering */
				"noDescendingSpecificity": "off"
			},
			"suspicious": {
				/* == coercion semantics against save strings / null-0 sentinels */
				"noDoubleEquals": "off",
				/* ~630 any annotations = tracked any-debt (audit 2026-09-12);
				   re-enable as the debt is paid down */
				"noExplicitAny": "off",
				/* same-scope var redeclaration is deliberate (hoisting, parity) */
				"noRedeclare": "off",
				/* chained assignments are idiomatic here */
				"noAssignInExpressions": "off",
				/* legacy coercion idioms */
				"noImplicitAnyLet": "off",
				"noGlobalIsNan": "off",
				"noGlobalIsFinite": "off",
				/* CSS vendor fallbacks repeat properties on purpose */
				"noDuplicateProperties": "off",
				/* globals.d.ts intentionally overloads the global
				   parseInt/parseFloat with numeric overloads */
				"noShadowRestrictedNames": "off",
				/* systems/ticker.ts has two identical <1e13 thresholds:
				   a 2.048 source bug (the "news station" ticker is
				   unreachable in the original too). Preserved verbatim —
				   "fixing" it would change gameplay. */
				"noDuplicateElseIf": "off",
				/* CSS: normalize.css reset (font: inherit after font-size) */
				"noShorthandPropertyOverrides": "off",
			/* CSS: placeholder rules (`.optionBox .option {}` etc.) and
			   keyframe frames kept from the port */
			"noEmptyBlock": "off",
			/* the port keeps 2.048 numeric literals verbatim (config.ts's
			   3.1415926… π approximation); substituting Math.PI would
			   change game values */
			"noApproximativeNumericConstant": "off",
			/* the save system is built on document.cookie (the 2.048
			   mechanism); no alternative applies */
			"noDocumentCookie": "off"
		},
			"complexity": {
				/* legacy function/bracket/&& style */
				"useArrowFunction": "off",
				"useLiteralKeys": "off",
				"useOptionalChain": "off",
				/* `arguments` is used on purpose in the port */
				"noArguments": "off",
				/* the @ts-ignore tombola quirk in content/upgrades.ts depends
				   on the comma expression */
				"noCommaOperator": "off",
				"noImportantStyles": "off",
				/* `export {}` module markers carry comments */
				"noUselessEmptyExport": "off"
			},
			"correctness": {
				/* 1300+ block-scoped var/function declarations; moving them
				   changes hoisting */
				"noInnerDeclarations": "off",
				/* useParseIntRadix (on since 2026-09-12): the 229 unradixed
				   parseInt sites from the verbatim port were fixed to
				   parseInt(x, 10) in the same change — decimal-only,
				   behavior-identical, and it stops the debt at the source.
				   The intentional base-16/base-2 parses in
				   utils/encoding.ts already carry their radix. */
				"useParseIntRadix": "error",
				"noInvalidUseBeforeDeclaration": "off",
				/* the game intentionally deals in
				   >Number.MAX_SAFE_INTEGER cookie counts
				   (tests/overflow.spec.js) */
				"noPrecisionLoss": "off",
				/* dead branches are intentional tombstones */
				"noConstantCondition": "off",
				/* CSS: -khtml- vendor prefix is not in the known set */
				"noUnknownProperty": "off",
				/* CSS: custom <sig> tag rendered in comments */
				"noUnknownTypeSelector": "off",
				/* core ctors keep the ported trailing `return this;`
				   (spec no-op; frozen content) */
				"noConstructorReturn": "off"
			}
		}
	}
}
