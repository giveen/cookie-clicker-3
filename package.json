{
  "name": "cookie-clicker-3",
  "private": true,
  "version": "3.0.0",
  "description": "Cookie Clicker 3 — a modern port of Cookie Clicker 2.048. TypeScript ES modules, Vite, zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:write": "biome check --write .",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "playwright test tests/qa.spec.js",
    "test:perf": "playwright test tests/perf.spec.js",
    "setup:master": "node scripts/setup-master.mjs",
    "test:compat": "npm run setup:master && playwright test tests/save-compat.spec.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
